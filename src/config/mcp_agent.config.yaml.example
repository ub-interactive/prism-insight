# Same layout as tracked `mcp_agent.config.yaml`. Copy only if you need a
# local template to diff against; secrets belong in `.env` (see .env.example).
# OPENAI_API_KEY, ANTHROPIC_API_KEY, FIRECRAWL_API_KEY, PERPLEXITY_API_KEY (see .env.example).
$schema: ../../schema/mcp-agent.config.schema.json

execution_engine: asyncio
logger:
  type: console
  level: info
  batch_size: 100
  flush_interval: 2
  max_queue_size: 2048
  http_timeout: 5

mcp:
  servers:
    firecrawl:
      command: "npx"
      args: ["-y", "firecrawl-mcp"]
      read_timeout_seconds: 120

    perplexity:
      command: "npx"
      args:
        [
          "-y",
          "@perplexity-ai/mcp-server",
        ]

    sqlite:
      command: "uv"
      args:
        [
          "--directory",
          "src/vendor/sqlite",
          "run",
          "mcp-server-sqlite",
          "--db-path",
          "stock_tracking_db",
        ]

    time:
      command: "uvx"
      args:
        [
          "mcp-server-time",
        ]

    yahoo_finance:
      command: "uvx"
      args: ["--from", "yahoo-finance-mcp", "yahoo-finance-mcp"]
      read_timeout_seconds: 120

openai:
  default_model: gpt-5.1
  reasoning_effort: high
  # Optional model overrides by workflow (keys used by src/prism/core/config/models.py)
  models:
    report_generation: gpt-5.4-mini
    us_journal: gpt-5.4-mini
    us_macro_analysis: gpt-5.4-mini
    us_report_filename: gpt-5.4-mini
    us_trading_decision: gpt-5.5
    us_sell_decision: gpt-5.5
    us_translation: gpt-5-nano

anthropic:
  default_model: claude-sonnet-4-6
  models:
    firecrawl_analyst: claude-sonnet-4-6

# Optional: Spark model for firecrawl_client.firecrawl_agent (default spark-1-mini)
# firecrawl:
#   spark_agent_model: spark-1-pro
